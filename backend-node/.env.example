# Copy this file to ".env" (remove ".example") and fill in your real values.
# Never commit the real .env file to GitHub - it's already in .gitignore.

# Gmail address that will SEND the alert
EMAIL_USER=youraddress@gmail.com

# A 16-character Gmail "App Password" - NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account.)
EMAIL_PASS=your16characterapppassword

# Where alerts get sent (can be same as EMAIL_USER)
ALERT_TO=manager@example.com
