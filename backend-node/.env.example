# Pulse Environment Configuration
PORT=5000
PYTHON_SERVICE_URL=http://localhost:5001/predict
CORS_ORIGIN=*

# Database Configuration (MySQL / Aiven Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=pulse_db

# Security & Authentication
# Generate a strong 32+ character random string for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# External Services
RESEND_API_KEY=re_your_resend_api_key
ALERT_TO=manager@example.com
GROQ_API_KEY=gsk_your_groq_api_key

# Optional Cron Security
CRON_SECRET=dev_cron_secret
